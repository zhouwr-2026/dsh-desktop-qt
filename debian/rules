#!/usr/bin/make -f
#
# DSH Desktop Debian 打包规则。
#
# 由 packaging/debian/control 与 packaging/debian/copyright 描述元数据。
# 主题导出 unit 与桌面自启动条目通过 debian/dsh-desktop.install（引用
# source 路径而非 debian/tmp 路径）复制到 /usr/lib/systemd/system 与
# /etc/xdg/autostart——这些绝对系统路径不进 CMake install，以免普通用户
# 跑 cpack 时因权限失败。

%:
	dh $@

override_dh_auto_configure:
	cmake --preset release

override_dh_auto_build:
	cmake --build build/release --parallel

override_dh_auto_test:
	ctest --test-dir build/release --output-on-failure

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp cmake --install build/release

# 卸载前停用 unit。
override_dh_prerm:
	dh_prerm
	deb-systemd-invoke stop dsh-theme-export.path || true
