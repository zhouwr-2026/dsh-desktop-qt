# Maintainer: zhouwr
# Arch Linux PKGBUILD for DSH Desktop (KDE Plasma 6 wrapper)

pkgname=dsh-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc='DeepSeek Harness 在 Arch Linux / KDE Plasma 6 上的原生托盘包装器'
arch=('x86_64' 'aarch64')
url='https://github.com/anywhere-labs/deepseek-harness-desktop'
license=('MIT')
depends=(
    'qt6-base>=6.6'
    'qt6-webengine>=6.6'
    'qt6-svg>=6.6'
    'libxcb>=1.17'
    'systemd'
    'polkit>=124'
    'procps-ng'
    'npm'
    'knotifications>=6.6'
)
makedepends=(
    'cmake>=3.19'
    'ninja'
    'pkgconf'
    'qt6-tools'
)
optdepends=(
    'polkit-kde-agent: polkit 密码框'
)
# source/sha256sums 由发布者打 v0.1.0 tag 时填充；本地构建请把 source 改
# 为 git+file://... 或跳过 makepkg 直接用 packaging/install.sh。
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cmake --preset release
    cmake --build build/release --parallel
}

check() {
    cd "$pkgname-$pkgver"
    ctest --test-dir build/release --output-on-failure
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build/release

    # CMake install 故意不写绝对系统路径（/usr/lib/systemd/system、
    # /etc/xdg/autostart），由 post-install.sh 在打包后落盘。
    install -Dm644 packaging/dsh-theme-export.service \
        "$pkgdir/usr/lib/systemd/system/dsh-theme-export.service"
    install -Dm644 packaging/dsh-theme-export.path \
        "$pkgdir/usr/lib/systemd/system/dsh-theme-export.path"
    install -Dm644 packaging/dsh-desktop.desktop \
        "$pkgdir/etc/xdg/autostart/dsh-desktop.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
