# Maintainer: zhouwr
# Arch Linux PKGBUILD for DSH Desktop (KDE Plasma 6 wrapper)

pkgname=dsh-desktop
pkgver=0.1.1
pkgrel=1
pkgdesc='DeepSeek Harness 在 Arch Linux / KDE Plasma 6 上的原生托盘包装器'
arch=('x86_64' 'aarch64')
url='https://github.com/anywhere-labs/deepseek-harness-desktop'
license=('MIT')
depends=(
    'qt6-base>=6.6'
    'qt6-webengine>=6.6'
    'qt6-svg>=6.6'
    'libxcb>=1.17'
    'systemd'
    'polkit>=124'
    'procps-ng'
    'npm'
    'knotifications>=6.6'
)
makedepends=(
    'cmake>=3.19'
    'ninja'
    'pkgconf'
    'qt6-tools'
)
optdepends=(
    'polkit-kde-agent: polkit 密码框'
)
# source/sha256sums 由发布者打 v0.1.0 tag 时填充；本地构建请把 source 改
# 为 git+file://... 或跳过 makepkg 直接用 packaging/install.sh。
source=("https://github.com/zhouwr-2026/dsh-desktop-qt/releases/download/v0.1.1/dsh-desktop-0.1.1-source.tar.gz")
sha256sums=('ef85d7ed0c45fc07cec7a0d8ac1506f6e16b50868fbfde12be0fb746614aa4b1')

build() {
    cd "$pkgname-$pkgver"
    cmake --preset release
    cmake --build build/release --parallel
}

check() {
    cd "$pkgname-$pkgver"
    ctest --test-dir build/release --output-on-failure
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build/release

    # CMake install 故意不写绝对系统路径（/usr/lib/systemd/system、
    # /etc/xdg/autostart），由 post-install.sh 在打包后落盘。
    install -Dm644 packaging/dsh-theme-export.service \
        "$pkgdir/usr/lib/systemd/system/dsh-theme-export.service"
    install -Dm644 packaging/dsh-theme-export.path \
        "$pkgdir/usr/lib/systemd/system/dsh-theme-export.path"
    install -Dm644 packaging/dsh-desktop.desktop \
        "$pkgdir/etc/xdg/autostart/dsh-desktop.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# 共享给所有发行版包的图标配色探测脚本（packaging/icon-brightness.sh）已由
# CMake install 装到 /usr/lib/dsh-desktop/icon-brightness.sh 并 chmod +x。
# post_install() 通过 subshell 调用它按本机真实 KDE users 的 colorscheme
# 选普通色版——避免全部用户都 fallback 到 CMake 装的固定黑色版（暗色
# look-and-feel 下看不见）。用 subshell 而非 source 是因为脚本是 bash 写的
# 内部用 [[ ]] / local 等，Arch post_install 跑在 bash 上下文也安全。
post_install() {
    local brightness_lib="/usr/lib/dsh-desktop/icon-brightness.sh"
    [[ -x "$brightness_lib" ]] || return 0
    local brightness src dst
    brightness="$("$brightness_lib")"
    case "$brightness" in
      dark)  src="/usr/share/icons/hicolor/scalable/apps/dsh-whale-white.svg" ;;
      *)     src="/usr/share/icons/hicolor/scalable/apps/dsh-whale-black.svg" ;;
    esac
    dst="/usr/share/icons/hicolor/scalable/apps/dsh-whale.svg"
    if [[ -r "$src" && -r "$dst" ]]; then
        cp -f "$src" "$dst"
        chmod 0644 "$dst"
        echo "==> dsh-desktop: hicolor dsh-whale.svg 已根据本机 KDE colorscheme ($brightness) 覆盖为 $(basename "$src")"
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
    fi
}
